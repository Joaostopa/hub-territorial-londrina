# Sem DATABASE_URL: usa data/imoveis.db ao lado do código, independentemente do CWD.
# SQLite alternativo no Windows: sqlite:///C:/Users/Joao Vitor/Desktop/hub/data/imoveis.db
# PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/imoveis_hub
DATABASE_URL=
# Opcional: diretório absoluto de dados (malhas, indicadores e cache).
# DATA_DIR=C:/imoveis-hub-data
AUTH_REQUIRED=false
# Para login obrigatório, configure também .streamlit/secrets.toml.
# Lista explícita de usuários. Com AUTH_REQUIRED=true e lista vazia, ninguém entra.
ALLOWED_EMAILS=
ADMIN_EMAILS=
# Use um contato institucional válido antes de coletar em produção.
HTTP_USER_AGENT=ImoveisHub/2.0 (internal research)
# Entrega opcional de alertas: somente quando executar alerts.py --notify.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# WhatsApp Business: template aprovado com 1 variável de texto no corpo.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=pt_BR

# Token configurado somente no seu computador; nunca compartilhe este arquivo.
APIFY_TOKEN=

# Opcional: geocodificação de endereços no piloto Curitiba (chave somente local).
# Confira franquia e cobrança no seu plano Geoapify.
GEOAPIFY_API_KEY=
